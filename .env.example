# Xero API Configuration for Custom Connections
XERO_CLIENT_ID=your_client_id_here
XERO_CLIENT_SECRET=your_client_secret_here
# Refresh-token auth: path to the token file written by `npx xero-auth`.
# Set this (with XERO_CLIENT_ID) to keep the server authenticated past the
# 30-minute access token lifetime. XERO_CLIENT_SECRET stays unset for a public
# PKCE app.
# XERO_TOKEN_FILE=/absolute/path/to/.xero-tokens.json